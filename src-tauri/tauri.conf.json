{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "抖音观看历史归档器",
  "version": "0.1.0",
  "identifier": "lifearchive.douyin-history-archive",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "抖音观看历史归档器",
        "width": 1080,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": "nsis",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "template": "nsis/installer-template.nsi",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
